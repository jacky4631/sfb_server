    <name>苏分宝开源淘客系统</name>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JDK 25：用 release 而非 source/target，避免误用低版本 JDK 的 bootclasspath -->
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <!-- 覆盖 BOM 的 lombok 版本，JDK 25 必须 1.18.48+ -->
        <lombok.version>1.18.48</lombok.version>
        <!-- API 文档：springfox 在 Jakarta/Spring Boot 3+ 已不可用，改 springdoc + knife4j jakarta 版 -->
        <springdoc.version>3.1.1</springdoc.version>
        <knife4j.version>4.5.0</knife4j.version>
        <!-- 持久层：Spring Boot 4 专用 starter -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <pagehelper.version>2.1.1</pagehelper.version>
        <httpclient4.version>4.5.14</httpclient4.version>
        <httpcore4.version>4.4.16</httpcore4.version>
        <druid.version>1.2.28</druid.version>
        <hutool.version>5.8.48</hutool.version>
        <poi.version>5.4.0</poi.version>
        <jjwt.version>0.12.6</jjwt.version>
        <jaxbApi.version>2.3.1</jaxbApi.version>
        <junit.version>4.13.2</junit.version>
        <!-- 默认仍不跑测试（保持原行为），需要时用 -DskipTests=false 打开 -->
        <skipTests>true</skipTests>
        <commons-pool2.version>2.5.0</commons-pool2.version>
        <mapstruct.version>1.2.0.Final</mapstruct.version>
        <xerces.version>2.11.0</xerces.version>
        <javax.version>1</javax.version>
        <whvcse.version>1.6.2</whvcse.version>
        <bitwalker.version>1.21</bitwalker.version>
        <aliyun.sms.version>2.0.16</aliyun.sms.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MP 3.5.17 把 PaginationInnerInterceptor 等依赖 JSqlParser 的插件拆到了独立坐标，
                 starter 不再默认带入 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-4-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper.version}</version>
            </dependency>
            <!-- HttpClient 4 已从 Spring Boot 4 的 BOM 中移除（官方只管 httpclient5），
                 但 48 处业务代码与部分厂商 SDK 仍依赖 HC4，此处显式锁版本 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient4.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpcore</artifactId>
                <version>${httpcore4.version}</version>
            </dependency>
            <!-- 厂商 jar（aspose-words / ysmp-java-sdk / pop-sdk）的字节码硬引用 javax.xml.bind，
                 而 JDK 11+ 已移除 JAXB。jaxb-api 自带 DatatypeConverterImpl，足以满足
                 base64/hex 转换与注解类加载；不引入 JAXB runtime，避免与 Spring Boot 4 的
                 jakarta 栈冲突。若后续真要跑 XML 绑定，再单独评估 com.sun.xml.bind:jaxb-impl -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxbApi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- Spring Boot 4 用 Jackson 3，官方 jjwt-jackson 会拖进 Jackson 2；
                 项目已有 gson，改用 jjwt-gson 作为序列化后端 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-gson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>dysmsapi20170525</artifactId>
                <version>2.0.16</version>
            </dependency>
            <dependency>
                <groupId>com.yeepay.yop.sdk</groupId>
                <artifactId>yop-java-sdk-biz</artifactId>
                <exclusions>
                    <exclusion>
                        <groupId>org.apache.tika</groupId>
                        <artifactId>tika-core</artifactId>
                    </exclusion>
                </exclusions>
                <version>4.3.3</version>
            </dependency>
            <dependency>
                <groupId>com.yeepay.yop.sdk</groupId>
                <artifactId>yop-java-sdk</artifactId>
                <exclusions>
                    <exclusion>
                        <groupId>org.apache.tika</groupId>
                        <artifactId>tika-core</artifactId>
                    </exclusion>
                </exclusions>
                <version>4.4.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>2.9.1</version>
            </dependency>

            <dependency>
                <groupId>com.sankuai.shepherd</groupId>
                <artifactId>meituan-union-java</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

